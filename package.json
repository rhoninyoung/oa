{
  "name": "oa-mvp",
  "version": "1.0.0",
  "private": true,
  "description": "OA Project Management MVP — pnpm monorepo",
  "type": "module",
  "packages": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080",
    "smoke": "python3 -m http.server 8080 & sleep 2 && echo 'Open http://localhost:8080'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "dev:backend": "pnpm --filter @oa-mvp/backend run start:dev",
    "db:migrate": "pnpm --filter @oa-mvp/backend run db:migrate",
    "db:seed": "pnpm --filter @oa-mvp/backend run db:seed"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "prisma": "^5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
