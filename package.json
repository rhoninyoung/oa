{
  "name": "oa-mvp-html",
  "version": "1.0.0",
  "description": "OA Project Management MVP — single-file HTML, localStorage, no build",
  "type": "module",
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080",
    "smoke": "python3 -m http.server 8080 & sleep 2 && echo 'Open http://localhost:8080'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
